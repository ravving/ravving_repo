{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ravving.github.io/ravving_repo/schemas/meta.schema.json",
  "title": "A ravving_repo entry",
  "type": "object",
  "required": ["id", "type", "name", "version"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "the entry's folder name, unique in the repository"},
    "type": {"type": "string", "enum": ["pack", "pattern", "sound", "template", "skin", "icons", "soundfont", "project"]},
    "name": {"type": "string", "minLength": 1, "maxLength": 64},
    "about": {"type": "string", "maxLength": 240, "description": "one line on it"},
    "author": {"type": "string", "maxLength": 64},
    "version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$", "description": "bumped whenever the files change"},
    "license": {"type": "string", "maxLength": 64, "description": "an SPDX id (CC-BY-4.0, CC0-1.0)"},
    "tags": {"type": "array", "items": {"type": "string", "maxLength": 32}, "maxItems": 12},
    "minAppVersion": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$", "description": "the oldest ravving that reads it"},
    "files": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._·-]{0,127}$"}, "maxItems": 8, "description": "what the entry ships, in its folder; a pack names its ravving folder"},
    "asset": {
      "type": "object",
      "description": "a soundfont's release asset (not committed)",
      "required": ["release", "file", "size", "sha256"],
      "additionalProperties": false,
      "properties": {
        "release": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "file": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,127}\\.(sf2|sf3)$"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
